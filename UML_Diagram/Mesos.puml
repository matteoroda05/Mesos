@startuml

package "Model" {

  class GameContext {
    - game_id: UUID
    - round_number: int '1-10
    - current_era: Era 'enum
    - game_table: GameTable
    - players: Map<Color, Player>
    - current_player_index: int
    - tribe_deck: TribeDeck
    - building_decks: BuildingDeck

    + setupGame(player_count: int): void
    + computeFinalScores(): ScoreBoard
  }

  class GameTable {
    - offer_track: OfferTrack
    - turn_order_tile: TurnOrderTile
    - top_row: MarketRow
    - bottom_row: MarketRow

    + getTopRow(): MarketRow
    + getBottomRow(): MarketRow
    + placeTotem(player: Player, offer_tile: OfferTile): void
    + discardBottomRowTribeCards(): void
    + moveTopToBottomTribeCards(): void
    + restoreTopRow(tribe_deck: TribeDeck, players_count: int): void
    + beginNewEra(building_decks: BuildingDecks): void
    + visibleEvents(include_top_row: boolean): List<EventCard>
  }

  class MarketRow {
    - tribe_market: List<TribeCard>
    - building_market: List<BuildingCard>

    + getCards(): List<Card>
    + getTakeableCards(player_food: int, builders_discount: int): List<Card>  'no Events or expensive buildings
    + takeCard(index: int, is_building: boolean): Card
    + placeCard(c: Card): void
    + removeTribeCards(): List<TribeCard>
    + removeBuildingCards(): List<BuildingCard>
  }

  class Player {
    - id: UUID
    - nickname: String
    - color: Color
    - tribe: Tribe
    - food: int
    - prestige: int

    
    + getNickname(): String
    + getColor(): Color
    + getTribe(): Tribe
    + getFood(): int
    + getPrestige(): int
    + gainFood(amount: int): void
    + loseFood(amount: int): void
    + gainPrestige(pp: int): void
    + losePrestige(pp: int): void
  }

  class Tribe {
    - characters: Dictionary<CharacterType, List<CharacterCard>>
    - buildings: List<BuildingCard>

    + addCard(c: CharacterCard): void
    + addCard(b: BuildingCard): void
    + getNumCharacters(): int
    + getNumCharcaterOfType(t: CharacterType): int
    + countShamanStars(): int
    + buildersDiscount(): int
    + gatherersDiscount(): int
    + inventorsIcons(): Set<InventionIcon>
    + buildingPrestige(): int
    + buildersEndGamePrestige(): int
    + inventorsEndGamePrestige(): int
    + artistsEndGamePrestige(): int
    + tribeEndGamePrestige(): int
  }

  class ScoreBoard {
    - finalPrestige: Map<Player, Integer>
    - finalFood: Map<Player, Integer>

    + winner(): Player
  }

  enum Era { 
    FIRST
    SECOND
    THIRD
  }

  enum Color { 
    BLUE
    YELLOW
    ORANGE
    WHITE
    BLACK
  }

  enum InventionIcon {
    BOAT
    ARROW
    HOOK
    NECKLACE
    BOWL
    ROPE
    DOLL
    STICK
    LEATHER
    BREAD
  }

  enum CharacterType {
    INVENTOR
    GATHERER
    SHAMAN
    BUILDER
    ARTIST
    HUNTER
  }

  abstract class Card {
    - card_id: UUID
    - era: Era
    - card_image: Image
    - min_players: int
  }

  abstract class TribeCard extends Card

  abstract class CharacterCard extends TribeCard 

  class HunterCard extends CharacterCard {
    - active_hunter: boolean

    + isActiveHunter(): boolean 
  }

  class ShamanCard extends CharacterCard {
    - num_stars: int

    + getStars(): int
  }

  class BuilderCard extends CharacterCard {
    - food_discount: int
    - prestige_points: int

    + getBuildingDiscount(): int
    + getPrestigePoints(): int
  }

  class GathererCard extends CharacterCard {
    - discount_value: int

    + getDiscount(): int
  }

  class ArtistCard extends CharacterCard

  class InventorCard extends CharacterCard {
    - invention_icon: InventionIcon

    + getInventionIcon(): InventionIcon
  }

  abstract class EventCard extends TribeCard {
    + Abstract calculateOutcome(player_tribes: List<Tribe>): List<int>
    + Abstract asTrigger(): BuildingTrigger
  }

  class SustainanceEvent extends EventCard {
    - points_penalty: int
    - food_per_character: int

    + getPointsPenalty(): int
  }

  class ShamanicRitualEvent extends EventCard {
    - winner_bonus: int
    - loser_penalty: int
  }

  class CavePaintingEvent extends EventCard {
    - threshold: int
    - points_per_artist: int
    - penalty: int
  }

  class HuntEvent extends EventCard {
    - prestige_per_hunter: int
    - food_gain_per_hunter: int
  }

  class BuildingCard extends Card {
    - foodCost: int
    - prestigePoints: int
    - owner: Player
    - trigger: BuildingTrigger
    - buildingEffect: BuildingEffect

    + canBeBoughtBy(p: Player): boolean
    + effectiveCostFor(p: Player): int
    + onAcquired(p: Player): void
    + effect(): boolean
  }


  interface BuildingEffect {
    + effect(source: BuildingCard): boolean
  }

  class TribeDeck {
    - deck: List<TribeCard>

    + drawTopRow(n_players: int): List<TribeCard>
    + drawInitialBottomRow(n_player: int): List<TribeCard>
    + isEmpty(): boolean
  }
 
  class BuildingDeck {
    - era: Era
    - cards: List<BuildingCard>

    + getBuildingCards(): List<BuildingCard>
    + isEmpty(): boolean
  }

  enum BuildingTrigger {
    ON_END_TURN
    ON_END_ROUND
    ON_END_GAME
    ON_EVENT_SUSTENANCE
    ON_EVENT_HUNT
    ON_EVENT_SHAMANIC_RITUAL
    ON_EVENT_CAVE_PAINTINGS
    ON_ACQUIRE_CHARACTER
  }

  class OfferTrack {
    -  tiles: List<OfferTile>

    + getAvailableTiles(): List<OfferTile> 
    + getTile(num: int):OfferTile 
    + getOccupiedTiles(): List<OfferTile>
  }

  class OfferTile {
    - offer_tile_id: char  ‘A…G
    - pick_top_row: int
    - pick_bottom_row: int
    - occupant: Color
    - food_gain: int
    - min_num_players: int

    + isAvailable(): boolean
    + occupy(player_color: Color): void
    + clear(): void
    + getTopPicks(): int
    + getBottomPicks(): int
    + getFoodGain(): int
  }

  class TurnOrderTile {
    - spaces: List<TurnOrderSpace>

    + placeTotem(player_color: Color): void
    + currentOrderTopToBottom(): List<Color>
  }

  class TurnOrderSpace {
    - int: foodBonus
    - occupant: Color

    + getBonus(): int
    + getOccupant(): Color
    + setOccupant(player: Color)
  }

}



' Associations
GameContext o-- Color
GameContext o-- Era
GameContext o-- GameTable
GameContext o– Player
GameContext o-- TribeDeck
GameContext o-- BuildingDeck

GameTable o-- OfferTrack
GameTable o-- TurnOrderTile
GameTable o-- MarketRow
GameTable o-- MarketRow

Tribe o-- CharacterCard
Tribe o-- BuildingCard
Tribe o-- CharacterType

ScoreBoard o– Player

MarketRow o-- TribeCard
MarketRow o-- BuildingCard

Player o-- Color
Player o-- Tribe

OfferTrack o-- OfferTile

OfferTile o-- Color

TurnOrderTile o-- TurnOrderSpace

TurnOrderSpace o-- Color

Card o-- Era

BuildingCard o-- BuildingTrigger
BuildingCard o-- Player
BuildingCard  o-- BuildingEffect

InventorCard o-- InventionIcon

TribeDeck o-- TribeCard

BuildingDeck o-- BuildingCard
BuildingDeck o-- Era

package "Controller" {

  class RequestController {
    - game_view: GameView   ‘inside View
    - gam_flow_controller: GameFlowController

    + pickCard(card_pos: int, upper_row: boolean): void
    + chooseOffer(tile_pos: int): void
    + exitGame(): void
    + viewScoreboard(): void
  }

  class GameFlowController {
    - model_controller: ModelController
    - phase: GamePhase
    - components: Map<...>  ‘everything loaded from the json file

    + GameFlowController(map_of_all: Map<...>): void
    + play(): void
    + round(): void
    + doActions(): void  ‘building trigger: END_OF_TURN, ON_ACQUIRE_CHARACTER
    + resolveEvents(): void  ‘building trigger: ON_EVENT 
    + restoreMarket(): void  ‘building trigger: END_ROUND
    + newEra(): void
    + finalScoring(): void  ‘building trigger: ON_END_GAME
    + endScreen(): void
  }

  enum GamePhase {
    LOADING,
    LOGIN,
    SETUP,
    ROUND_OFFER,
    ROUND_ACTIONS,
    ROUND_EVENTS,
    ROUND_END,  ‘market sup -> inf, new market row
    FINAL_EVENTS,
    END_GAME,
    END_SCREEN
  }

  class ModelController {
    - game: GameContext

    + createBoard(numPlayers: int, components: Map<...>): void
    + playerChooseOffer(player: Color, offer: int): void
    + playerChooseCard(player: Color, card: int): void
    + playerChooseBuilding(player: Color, building: int): void
    + activateBuildingEffect(player: Color, trigger: BuildingTrigger): void
    + playerEndTurn(player: Color): void  ‘reward for position
    + newEra(): void
    + getEventsBottom(): List<EventCard>
    + endRound(): void
      ‘moves cards from upper to lower market row
    + changePrestige(player: Color, prestige: int): void
    + changeFood(player: Color, food: int): void
  }
}

'Associazioni interpakcage

Controller  o-- Model

@enduml
